{
  "headers": [
    {
      "source": "/home/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/home/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/home/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home/conditions",
      "destination": "/home/#conditions",
      "permanent": true
    },
    {
      "source": "/home/conditions/",
      "destination": "/home/#conditions",
      "permanent": true
    },
    {
      "source": "/home/team",
      "destination": "/home/about/#team",
      "permanent": true
    },
    {
      "source": "/home/team/",
      "destination": "/home/about/#team",
      "permanent": true
    }
  ]
}
